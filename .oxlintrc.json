{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-debugger": "error",
    "eslint/no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "docs"
  ]
}
