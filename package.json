{
  "name": "formatpro3-workflow",
  "private": true,
  "version": "1.2.0",
  "description": "FormatPro3 Workflow — Automatisation visuelle de workflows",
  "keywords": [
    "workflow",
    "automation",
    "n8n",
    "no-code",
    "react",
    "react-flow",
    "vite",
    "typescript",
    "electron",
    "desktop",
    "pwa"
  ],
  "homepage": "https://ck526438-lgtm.github.io/formatpro3-workflow/",
  "bugs": {
    "url": "https://github.com/ck526438-lgtm/formatpro3-workflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ck526438-lgtm/formatpro3-workflow.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "author": {
    "name": "ck526438-lgtm",
    "url": "https://github.com/ck526438-lgtm"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.formatpro3.workflow",
    "productName": "FormatPro3 Workflow",
    "copyright": "© 2026 ck526438-lgtm — MIT",
    "artifactName": "FormatPro3-Workflow-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.mjs",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "FormatPro3-Workflow-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FormatPro3 Workflow",
      "language": "1036"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "ck526438-lgtm",
      "synopsis": "Automatisation visuelle de workflows",
      "syncDesktopName": true
    }
  },
  "desktopName": "formatpro3-workflow.desktop"
}
